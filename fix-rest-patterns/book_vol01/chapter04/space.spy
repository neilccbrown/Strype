'''Space - a demo project to show directional movement

This project is part of the book "Creative programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
#(=> Section:Definitions
def move (x_dir,y_dir ) :
    '''Move in x- and y-direction. Each parameter should be either -1, 0, or 1 to indivate the direction of movement in each dimension.'''
    player.set_location(player.get_x() + (x_dir * SPEED),player.get_y() + (y_dir * SPEED)) 
#(=> Section:Main
set_background(load_image("data:image/jpeg;base64,")) 
SPEED  = 8 
player  = Actor(load_image("data:image/png;base64,")) 
while True  :
    if key_pressed("left")  :
        move(-1,0) 
    if key_pressed("right")  :
        move(1,0) 
    if key_pressed("up")  :
        move(0,1) 
    if key_pressed("down")  :
        move(0,-1) 
    pace(30) 
#(=> Section:End
