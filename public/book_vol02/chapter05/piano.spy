'''Piano, version 1.0

Press the keys on your keyboard to play.

This project is part of the book "Creative programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
from strype.sound import * 
#(=> Section:Definitions
white_keys  = ["A","S","D","F","G","H","J","K","L",";","'","\\"] 
white_notes  = [load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,")] 
black_keys  = ["W","E","","T","Y","U","","O","P","","]"] 
black_notes  = [load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),None,load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),None,load_sound("data:audio/x-wav;base64,"),load_sound("data:audio/x-wav;base64,"),None,load_sound("data:audio/x-wav;base64,")] 
class Key(Actor)  :
    '''A key on a piano'''
    #(=> FrameState:FoldToHeader
    def __init__ (self,key_name,sound,up_image,down_image,x,y ) :
        '''Create the key.
        Parameters:
          key_name: The name of the keyboard key this piano key should react to (str)
          sound: The sound to produce if pressed (Sound)
          up_image: The image to show when the key is not ptressed down (Image)
          down_image: The key to show if this key is pressed down (Image)
          x, y: The coordinated for this key on screen (int)'''
        self.key_name  = key_name 
        self.sound  = sound 
        self.up_image  = up_image 
        self.down_image  = down_image 
        super().__init__(self.up_image,x,y,"key") 
        self.is_down  = False 
    #(=> FrameState:FoldToDocumentation
    def react (self, ) :
        '''React to key presses: If our keyboard key is pressed, play a sound.'''
        if not self.is_down and key_pressed(self.key_name)  :
            self.sound.play() 
            self.set_image(self.down_image) 
            self.is_down  = True 
        if self.is_down and  not key_pressed(self.key_name)  :
            self.set_image(self.up_image) 
            self.is_down  = False 
#(=> Section:Main
set_background(load_image("data:image/jpeg;base64,")) 

#Create the keys
for i  in range(len(white_keys))  :
    key  = Key(white_keys[i],white_notes[i],load_image("data:image/png;base64,"),load_image("data:image/png;base64,"),i * 63 - 350,140) 
for i  in range(len(black_keys))  :
    if black_keys[i]  :
        key  = Key(black_keys[i],black_notes[i],load_image("data:image/png;base64,"),load_image("data:image/png;base64,"),i * 63 - 320,190) 

#Run the main loop
while True  :
    for key  in get_actors("key")  :
        key.react() 
#(=> Section:End
