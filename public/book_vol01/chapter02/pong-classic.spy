#(=> Section:Imports
from strype.graphics import * 
#(=> Section:Definitions
#(=> Section:Main
set_background(load_image("data:image/png;base64,")) 
paddle  = Actor(load_image("data:image/png;base64,"),-360,0) 
while True  :
    if key_pressed("up")  :
        paddle.set_location(paddle.get_x(),paddle.get_y() + 10) 
    if key_pressed("down")  :
        paddle.set_location(paddle.get_x(),paddle.get_y() - 10) 
    pace(30) 
#(=> Section:End
