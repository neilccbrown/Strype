'''smoke, version 0.1

This short demo shows you how to create a smoke efffect.

This project is part of the book "Creative Python Programming with Strype".
Author: Michael Kölling'''
#(=> Section:Imports
from strype.graphics import * 
import random 
#(=> Section:Definitions
PADDLE_SPEED  = 10 
def release_ball ( ) :
    '''Release the ball from the paddle. Once it is released, the ball will travel independently. Ball movement starts with a random angle.'''
    #dx and dx are the distances of movement in each direction that the ball will move in each step.
    global ball_dx 
    ball_dx  = random.randint(-12,12) 
    global ball_dy 
    ball_dy  = 12 
    global ball_stuck 
    ball_stuck  = False 
def check_wall ( ) :
    '''Check whether the ball has bit the wall. If it has, bounce off it.'''
    global ball_dx 
    global ball_dy 
    if ball.get_x() < -390 or ball.get_x() > 390  :
        ball_dx  = -ball_dx 
    if ball.get_y() > 290  :
        ball_dy  = -ball_dy 
def check_paddle ( ) :
    '''Check whether the ball has hit the paddle. If it has, bounce of it.'''
    if ball.get_touching("paddle")  :
        global ball_dx 
        global ball_dy 
        ball_dy  = -ball_dy 
        offset  = ball.get_x() - paddle.get_x() 
        ball_dx  = ball_dx + (offset / 10) 
def check_out ( ) :
    '''Check whether the ball is out of play. If it is, stop the game.'''
    if ball.get_y() < -298  :
        ball.remove() 
        stop() 
def make_smoke ( ) :
    '''Draw the smoke.'''
    for smoke  in get_actors("smoke")  :
        img  = smoke.get_image() 
        if img.get_width() < 20  :
            smoke.remove() 
        else :
            smoke.set_image(img.clone(smoke.shrink_rate)) 
    #Make sure to create a new smoke puff every second time
    global draw_smoke 
    if draw_smoke  :
        smoke  = Actor(smoke_img,ball.get_x(),ball.get_y(),"smoke") 
        #(=> Disabled:smoke.shrink_rate  = random.gauss(0.85,0.04) 
        smoke.shrink_rate  = random.choice([0.75,0.84,0.85,0.86,0.95]) 
        draw_smoke  = False 
    else :
        draw_smoke  = True 
def move_ball ( ) :
    '''Move the ball. Make sure it bounces off the walls and the paddle.'''
    ball.set_location(ball.get_x() + ball_dx,ball.get_y() + ball_dy) 
    check_wall() 
    check_paddle() 
def move_paddle ( ) :
    '''Check for key presses and move the paddle accordingly.'''
    if key_pressed("left")  :
        paddle.move(-PADDLE_SPEED) 
        if ball_stuck  :
            ball.move(-PADDLE_SPEED) 
    if key_pressed("right")  :
        paddle.move(PADDLE_SPEED) 
        if ball_stuck  :
            ball.move(PADDLE_SPEED) 
    if ball_stuck and key_pressed("space")  :
        release_ball() 
def act ( ) :
    '''React to key presses and move the actors.'''
    move_paddle() 
    if not ball_stuck  :
        move_ball() 
        make_smoke() 
        check_out() 
#(=> Section:Main
set_background("beige") 
paddle  = Actor(load_image("data:image/png;base64,"),0,-244,"paddle") 
ball  = Actor(load_image("data:image/png;base64,"),0,-200) 
smoke_img  = load_image("data:image/png;base64,") 
draw_smoke  = True 
ball_stuck  = True 
while True  :
    act() 
    pace(40) 
#(=> Section:End
