'''This project uses file reading, and pre-supplied files, to print out the average London temperature for 2005, 2015 and 2025'''
#(=> Section:Imports
#(=> Section:Definitions
def average_temperature_for_year (filename ) :
    '''Prints the average temperature, given the name of a file full of temperature data'''
    with open(filename)  as f  :
        total  = 0
        count  = 0
        for line in f :
            if line.strip() != "" :
                total  = total + float(line)
                count  = count + 1
    return round(total / count, 2)
#(=> Section:Main
#The 2005 and 2015 files are supplied with this project specifically - see the files tab on the bottom right pane:
print("2005:" + str(average_temperature_for_year("london-temperature-2005.txt"))) 
print("2015:" + str(average_temperature_for_year("london-temperature-2015.txt"))) 

#The 2025 file is supplied with Strype:
print("2025:" + str(average_temperature_for_year("/data/london-temperature-2025.txt"))) 
#(=> Section:End
