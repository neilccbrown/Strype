'''platform, version 0.2

A procect shows a scene for a classis platformer game. It shows how you can implement moving, jumpting and falling. This version adds animation of the player character to move the feet when walking.

This project is part of the book "Creative Python Programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
#(=> Section:Definitions
def setup ( ) :
    '''Create all the game elements.'''
    #Set up the player
    global SPEED 
    SPEED  = 9 
    global player_img_standing 
    player_img_standing  = load_image("data:image/png;base64,") 
    global player_img_left 
    player_img_left  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    global player_img_right 
    player_img_right  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    global img_no 
    img_no  = 0 
    
    global JUMP_STRENGTH 
    JUMP_STRENGTH  = 28 
    global ACCELERATION 
    ACCELERATION  = 3 
    #vertical speed
    global v_speed 
    v_speed  = 0 
    
    platform_img  = load_image("data:image/png;base64,") 
    p1  = Actor(platform_img,-260,-200) 
    p2  = Actor(platform_img,-50,-100) 
    p3  = Actor(platform_img,240,0) 
    p4  = Actor(platform_img,-30,130) 
    
    global player 
    player  = Actor(player_img_standing,-280,-136) 
    
    set_background(load_image("data:image/jpeg;base64,")) 
def on_ground ( ) :
    '''Check whether we are on solid ground. Return True if we are, False otherwise.'''
    #We calculate the location under our feet (our own y minus 50), and then check whether there is an actor there
    at_feet  = get_actor_at(player.get_x(),player.get_y() - 50) 
    return at_feet != None 
def alternate_images (images ) :
    '''Alternate the two walking images'''
    global img_no 
    img_no  = (img_no + 1) % 2 
    player.set_image(images[img_no]) 
def fall ( ) :
    '''Fall down. Accelerate as we fall. If we fall all the way to the bottom, it\'s game over.'''
    global v_speed 
    player.set_location(player.get_x(),player.get_y() - v_speed) 
    v_speed  = v_speed + ACCELERATION 
    if at_bottom()  :
        game_end() 
def at_bottom ( ) :
    '''Return True if we are at the bottom of the screen.'''
    return player.get_y() < -290 
def game_end ( ) :
    '''End the game. Do whatever you want to do at the end.'''
    stop() 
def move_right (images ) :
    '''Move the player to the right.'''
    alternate_images(images) 
    player.set_location(player.get_x() + SPEED,None) 
def move_left (images ) :
    '''Move the player to the left.'''
    alternate_images(images) 
    player.set_location(player.get_x() - SPEED,None) 
def jump ( ) :
    '''Jump up. This does the following: set the current vertical speed to move upwards, and then go to usual falling behaviour.'''
    global v_speed 
    v_speed  = -JUMP_STRENGTH 
    fall() 
def check_keys ( ) :
    '''Check for key presses and react accordingly.'''
    if key_pressed("left")  :
        move_left(player_img_left) 
    elif key_pressed("right")  :
        move_right(player_img_right) 
    else :
        player.set_image(player_img_standing) 
    if key_pressed(" ")  :
        if on_ground()  :
            jump() 
def check_fall ( ) :
    '''Check whether we should be falling down. Move the player accordingly.'''
    global v_speed 
    if on_ground()  :
        v_speed  = 0 
    else :
        fall() 
def main_loop ( ) :
    '''Run the game main loop.'''
    while True  :
        check_keys() 
        check_fall() 
        pace(30) 
#(=> Section:Main
setup() 
main_loop() 
#(=> Section:End
