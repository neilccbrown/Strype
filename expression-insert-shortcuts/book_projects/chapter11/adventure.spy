'''Adventure, version 0.1

This is an interactive graphical version of an adventure game in the style of "Haunted Mansion".
In this version, you do not give text commands, but instead play with a graphical game character. You can see that this version takes a bit more work. It is not conceptually that much more difficult, but dealing with the graphics (and making the graphics!) takes more time.

This project is part of the book "Creative Python Programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
from collections import namedtuple 
from random import randint 
#(=> Section:Definitions
def make_item (image,x,y,description,weight ) :
    '''Make an item. An item is an Actor with some added data stored in the actor.
    Returns the new item.'''
    item  = Actor(image,x,y,"item") 
    #items are automatically shown in the world, but we do not want to show these items just yet
    item.remove() 
    #add additional data to the actor object
    item.description  = description 
    item.weight  = weight 
    item.x  = x 
    item.y  = y 
    return item 
def setup ( ) :
    '''Create the whole world scenario.'''
    #Create the items
    book  = make_item(load_image("data:image/png;base64,"),100,-100,"an old dusty book",1.2) 
    key  = make_item(load_image("data:image/png;base64,"),-320,200,"an big shiny brass key",0.2) 
    
    #Create the rooms
    Room  = namedtuple("Room",["image","description","items","exits"]) 
    outside  = Room(load_image("data:image/png;base64,"),"outside, in front of a big old building",[],{"west":"library"}) 
    library  = Room(load_image("data:image/png;base64,"),"in the library. It is full of books.",[key,book],{"north":"kitchen","east":"outside"}) 
    kitchen  = Room(load_image("data:image/png;base64,"),"in the kitchen",[],{"south":"library"}) 
    global rooms 
    rooms  = {"outside":outside,"library":library,"kitchen":kitchen} 
    
    #Set up the player
    global SPEED 
    SPEED  = 25 
    global image_standing 
    image_standing  = load_image("data:image/png;base64,") 
    
    images_left  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    images_right  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    images_up  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    images_down  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    global player_img 
    player_img  = {"left":images_left,"right":images_right,"up":images_up,"down":images_down} 
    global img_no 
    img_no  = 0 
    
    global player 
    player  = Actor(image_standing) 
    global inventory 
    inventory  = [] 
    
    enter_room(library) 
    print("Press 'h' for help.") 
#room functions
def show_text (text ) :
    '''Show some text in the console. Clear the console first before showing the new text.'''
    clear_console() 
    print(text) 
def enter_room (room ) :
    '''Enter a new room. The room to enter is given in the parameter.'''
    #remove all visible items from screen
    remove_actors("item") 
    
    global current_room 
    current_room  = room 
    set_background(current_room.image) 
    
    #add the items in the new room to the screen
    for item  in current_room.items  :
        item.re_add(item.x,item.y) 
    
    show_text("You are " + current_room.description) 
def check_door ( ) :
    '''Check whether we are currently at a door.
    Returns the next room we are getting into via that door, and the (x,y) position on screen where we should be placed after entering. Returns \'None\' for the next room if we are not at a door.'''
    exits  = current_room.exits 
    next_room  = None 
    next_pos  = (0,0) 
    if player.get_x() <= -399 and player.get_y() > -50 and player.get_y() < 50  :
        next_room  = exits.get("west") 
        next_pos  = (400,0) 
    if player.get_x() >= 399 and player.get_y() > -50 and player.get_y() < 50  :
        next_room  = exits.get("east") 
        next_pos  = (-400,0) 
    if player.get_y() <= -299 and player.get_x() > -50 and player.get_x() < 50  :
        next_room  = exits.get("south") 
        next_pos  = (0,300) 
    if player.get_y() >= 299 and player.get_x() > -50 and player.get_x() < 50  :
        next_room  = exits.get("north") 
        next_pos  = (0,-300) 
    return next_room,next_pos 
def move (x_dir,y_dir,images ) :
    '''Move the player character. The direction parameters should be -1, 0, or 1 to indicate the direction.'''
    global img_no 
    img_no  = (img_no + 1) % 2 
    player.set_image(images[img_no]) 
    player.set_location(player.get_x() + (x_dir * SPEED),player.get_y() + (y_dir * SPEED)) 
    next_room_name,location  = check_door() 
    if next_room_name != None  :
        enter_room(rooms[next_room_name]) 
        player.set_location(location[0],location[1]) 
def look ( ) :
    '''Look around you. If we are touching an item, show the item\'s description. Otherwise, show the room\'s description.'''
    item  = player.get_touching("item") 
    if item  :
        player.say_for(item.description,2) 
    else :
        show_text("You are " + current_room.description) 
def take ( ) :
    '''If we are currently touching an item, take it. Otherwise do nothing.'''
    item  = player.get_touching("item") 
    if item  :
        #remove item actor from graphics world
        item.remove() 
        #remove item actor from list of items in room
        current_room.items.remove(item) 
        
        inventory.append(item) 
def drop ( ) :
    '''Drop an item. Actually, the current implementation drops ALL items we are carrying. Should probably be improved to be able to specify which item we want to drop.'''
    global inventory 
    for item  in inventory  :
        current_room.items.append(item) 
        item.x  = player.get_x() + randint(-40,40) 
        item.y  = player.get_y() + randint(-40,40) 
        item.re_add(item.x,item.y) 
    inventory  = [] 
def show_inventory ( ) :
    '''Show what we are currently carrying.'''
    clear_console() 
    print("You are carrying:") 
    if len(inventory) > 0  :
        for item  in inventory  :
            print("   " + item.description) 
    else :
        print("   nothing") 
def print_help ( ) :
    '''Print some help text.'''
    clear_console() 
    print("Keys:") 
    print("   [left/right/up/down]  walk") 
    print("   [space]  look") 
    print("   [t]  take") 
    print("   [d]  drop") 
    print("   [i]  inventory") 
    print("   [h]  help") 
    print("   [q]  quit") 
def main_loop ( ) :
    '''Run the game main loop. This will run until the player chooses to quit.'''
    finished  = False 
    while not finished  :
        pace(8) 
        if key_pressed("left")  :
            move(-1,0,player_img["left"]) 
        elif key_pressed("right")  :
            move(1,0,player_img["right"]) 
        elif key_pressed("up")  :
            move(0,1,player_img["up"]) 
        elif key_pressed("down")  :
            move(0,-1,player_img["down"]) 
        elif key_pressed(" ")  :
            look() 
        elif key_pressed("t")  :
            take() 
        elif key_pressed("d")  :
            drop() 
        elif key_pressed("h")  :
            print_help() 
        elif key_pressed("i")  :
            show_inventory() 
        elif key_pressed("q")  :
            show_text("Good bye.") 
            finished  = True 
        else :
            player.set_image(image_standing) 
#(=> Section:Main
setup() 
main_loop() 
#(=> Section:End
