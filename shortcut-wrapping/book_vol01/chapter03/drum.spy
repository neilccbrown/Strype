'''drum, version 1

A simple project using a few actors and sound.

This is an extension project; it is part of the book "Creative Python Programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
from strype.sound import * 
#(=> Section:Definitions
def hit (stick,rotation,sound ) :
    '''Hit the drum with a drum stick'''
    sound.play() 
    stick.turn(rotation) 
def release (stick,rotation ) :
    '''Lift up the drum stick again'''
    stick.turn(rotation) 
def react_to_keys ( ) :
    '''React to a key press: If our keyboard key is pressed, play the drum sound.'''
    global left_is_on_drum 
    global right_is_on_drum 
    if not left_is_on_drum and key_pressed("left")  :
        hit(left_stick,-ROTATION,drum1) 
        left_is_on_drum  = True 
    if left_is_on_drum and  not key_pressed("left")  :
        release(left_stick,ROTATION) 
        left_is_on_drum  = False 
    if not right_is_on_drum and key_pressed("right")  :
        hit(right_stick,ROTATION,drum2) 
        right_is_on_drum  = True 
    if right_is_on_drum and  not key_pressed("right")  :
        release(right_stick,-ROTATION) 
        right_is_on_drum  = False 
#(=> Section:Main
set_background("white") 
show_text("Play with left/right arrow keys",0,-270) 
drum1  = load_sound("data:audio/x-wav;base64,") 
drum2  = load_sound("data:audio/x-wav;base64,") 
ROTATION  = 40 

drum  = Actor(load_image("data:image/png;base64,")) 
left_stick  = Actor(load_image("data:image/png;base64,"),-75,100) 
right_stick  = Actor(load_image("data:image/png;base64,"),75,90) 

left_is_on_drum  = False 
right_is_on_drum  = False 
while True  :
    react_to_keys() 
#(=> Section:End
