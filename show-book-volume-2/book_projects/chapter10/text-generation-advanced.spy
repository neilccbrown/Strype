'''text-generation, Version 0.4

In this version, we have rewritten the \'generate_next_word\' function to make use of some more advanced Python constructs, which we have not previously seen.

This project is part of the book "Creative Python Programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
import random 
#(=> Section:Definitions
#(=> FrameState:FoldToHeader;Frozen
def read_file (filename ) :
    '''Reads the full content of the file and returns it as a string'''
    with open(filename,encoding="utf-8")  as f  :
        return f.read() 
def make_trigrams (text ) :
    '''Constructs a dict that associates each word with a list of following words.'''
    words  = text.split() 
    triples  = zip(words,words[1:],words[2:]) 
    return list(triples) 
def get_random_word (ngrams ) :
    return random.choice(ngrams)[0] 
def generate_next_word (word1,word2,trigrams ) :
    '''Generates a sentence with at most max_word_count words from next_words which associates word keys to lists of possible following words.'''
    following  = [triple[2] for triple in trigrams if triple[0] == word1 and triple[1] == word2] 
    if not following  :
        following  = [triple[2] for triple in trigrams if triple[1] == word2] 
    return random.choice(following) if len(following) > 0 else get_random_word(trigrams) 
#(=> Section:Main
text  = read_file("/books/sherlock-holmes.txt") 
ngrams  = make_trigrams(text) 

word1,word2  = "It","was" 
print(f"{word1} {word2}",end=" ") 
for n  in range(50)  :
    next_word  = generate_next_word(word1,word2,ngrams) 
    print(next_word,end=" ") 
    word1  = word2 
    word2  = next_word 
#(=> Section:End
